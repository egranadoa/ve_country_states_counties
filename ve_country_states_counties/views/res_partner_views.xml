<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_inherit_municipality" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.municipality.parish</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <!-- Insertar el campo municipio justo después del campo 'state' (Estado) -->
            <xpath expr="//field[@name='state_id']" position="after">
                <field name="municipality_id" 
                       placeholder="Municipio" 
                       class="o_address_state"
                       options="{'no_open': True, 'no_create': True}"/>
                <field name="parish_id" 
                       placeholder="Parroquia" 
                       class="o_address_state"
                       options="{'no_open': True, 'no_create': True}"/>
            </xpath>
        </field>
    </record>
    <record id="view_company_form_inherit_municipality" model="ir.ui.view">
        <field name="name">res.company.form.inherit.municipality.parish</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <!-- Insertar el campo municipio justo después del campo 'state' (Estado) -->
            <xpath expr="//field[@name='state_id']" position="after">
                <field name="municipality_id" 
                       placeholder="Municipio" 
                       class="o_address_state"
                       options="{'no_open': True, 'no_create': True}"/>
                <field name="parish_id" 
                       placeholder="Parroquia" 
                       class="o_address_state"
                       options="{'no_open': True, 'no_create': True}"/>
            </xpath>
        </field>
    </record>
</odoo>